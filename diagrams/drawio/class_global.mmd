classDiagram
  %% Import in draw.io: Arrange > Insert > Advanced > Mermaid
  %% Diagram: Global class diagram derived from PostgreSQL schema and backend modules

  class User {
    UUID id
    string email
    string username
    string password_hash
    string google_id
    string github_id
    string profile_pic
    string bio
    user_type_enum user_type
    user_status_enum status
    boolean is_seller
    decimal rating_average
    int rating_count
    string company_position
    UUID supervisor_id
    Date created_at
    Date updated_at
  }

  class Role {
    int id
    string name
    string description
    user_type_enum user_type
    int hierarchy_level
  }

  class Permission {
    int id
    string name
    string description
    string category
  }

  class Category {
    int id
    string name
    string slug
    string description
    boolean is_active
  }

  class Asset {
    UUID id
    UUID seller_id
    int category_id
    string title
    text description
    decimal price
    decimal discount
    string thumbnail_url
    string file_url
    bigint file_size
    asset_status_enum status
    boolean is_free
    int download_count
    int view_count
    int likes_count
    decimal rating_average
    int rating_count
    json metadata
  }

  class AssetFormat {
    UUID id
    UUID asset_id
    string format
    string label
    string file_url
    bigint file_size
  }

  class Order {
    UUID id
    UUID buyer_id
    decimal total_amount
    payment_method_enum payment_method
    string payment_reference
    order_status_enum status
  }

  class OrderItem {
    UUID id
    UUID order_id
    UUID asset_id
    decimal price_at_purchase
    UUID seller_id
  }

  class CartItem {
    UUID user_id
    UUID asset_id
    Date added_at
  }

  class UserDownload {
    UUID user_id
    UUID asset_id
    UUID order_id
    Date downloaded_at
  }

  class AssetReview {
    UUID id
    UUID asset_id
    UUID user_id
    UUID rating_id
    string title
    text body
    string ai_sentiment
    text ai_summary
    boolean flagged_for_moderation
  }

  class AssetRating {
    UUID id
    UUID asset_id
    UUID user_id
    smallint stars
  }

  class RoleRequest {
    UUID id
    UUID user_id
    string requested_role
    text reason
    string status
    UUID reviewed_by
  }

  class AssetEditRequest {
    UUID id
    UUID asset_id
    UUID requester_id
    json changes
    string status
    UUID reviewed_by
  }

  class InternAssetRequest {
    UUID id
    UUID intern_id
    UUID asset_id
    text message
    string status
    UUID reviewed_by
  }

  class VoucherCode {
    UUID id
    string code
    UUID asset_id
    UUID created_by
    int max_uses
    int uses_count
    Date expires_at
    boolean is_active
  }

  class SubscriptionPlan {
    UUID id
    string slug
    string name
    decimal price
    string billing_cycle
    json features
  }

  class UserSubscription {
    UUID id
    UUID user_id
    UUID plan_id
    string status
    Date started_at
    Date expires_at
  }

  class Group {
    UUID id
    string name
    text description
    UUID owner_id
    boolean is_public
  }

  class Trade {
    UUID id
    UUID initiator_id
    UUID recipient_id
    UUID offered_asset_id
    UUID requested_asset_id
    string status
    text message
  }

  class Project {
    UUID id
    string name
    text description
    string status
    string priority
    Date deadline
    int progress
    UUID created_by
  }

  class WorkspaceTask {
    UUID id
    string title
    text description
    string status
    string priority
    UUID assignee_id
    UUID creator_id
    UUID project_id
    Date due_date
  }

  class ChatChannel {
    UUID id
    string name
    text description
    string type
    string min_role
    UUID created_by
  }

  class ChatMessage {
    UUID id
    UUID channel_id
    UUID user_id
    text content
    boolean edited
    boolean deleted
  }

  class Notification {
    UUID id
    UUID user_id
    string type
    string title
    text message
    boolean is_read
    json data
  }

  class AuditLog {
    UUID id
    UUID user_id
    string action
    string resource_type
    string resource_id
    json details
  }

  User "0..*" -- "0..*" Role : user_roles
  Role "0..*" -- "0..*" Permission : role_permissions
  User "1" -- "0..*" Asset : sells
  Category "1" -- "0..*" Asset : classifies
  Asset "1" -- "0..*" AssetFormat : has
  User "1" -- "0..*" Order : buys
  Order "1" -- "1..*" OrderItem : contains
  Asset "1" -- "0..*" OrderItem : purchased_as
  User "1" -- "0..*" CartItem : owns
  Asset "1" -- "0..*" CartItem : in_cart
  User "1" -- "0..*" UserDownload : downloads
  Asset "1" -- "0..*" UserDownload : unlocked
  Asset "1" -- "0..*" AssetReview : receives
  User "1" -- "0..*" AssetReview : writes
  Asset "1" -- "0..*" AssetRating : receives
  User "1" -- "0..*" RoleRequest : submits
  Asset "1" -- "0..*" AssetEditRequest : changed_by_request
  User "1" -- "0..*" InternAssetRequest : intern_requests
  Asset "1" -- "0..*" InternAssetRequest : requested
  Asset "0..1" -- "0..*" VoucherCode : unlocks
  User "1" -- "0..*" VoucherCode : creates
  SubscriptionPlan "1" -- "0..*" UserSubscription : selected
  User "1" -- "0..*" UserSubscription : subscribes
  User "1" -- "0..*" Group : owns
  User "1" -- "0..*" Trade : initiates
  User "1" -- "0..*" Trade : receives
  Asset "0..1" -- "0..*" Trade : offered_or_requested
  User "1" -- "0..*" Project : creates
  Project "1" -- "0..*" WorkspaceTask : contains
  User "1" -- "0..*" WorkspaceTask : assigned_or_created
  ChatChannel "1" -- "0..*" ChatMessage : contains
  User "1" -- "0..*" ChatMessage : sends
  User "1" -- "0..*" Notification : receives
  User "1" -- "0..*" AuditLog : generates

